# Maintainer: MOWIS Project <mowis-dev@proton.me>
pkgname=mowis-desktop-environment
pkgver=1.0.0
pkgrel=1
pkgdesc="MOWIS Desktop Environment — Samsung DeX-inspired, built on UKUI (Qt/MATE fork)"
arch=('any')
url="https://github.com/mowis-de/mowis-desktop-environment"
license=('GPL2')
groups=('mowis')

# Core UKUI engine
depends=(
    'ukui-session-manager'
    'ukui-panel'
    'ukui-settings-daemon'
    'ukui-control-center'
    'ukui-menu'
    'ukui-sidebar'
    'ukui-kwin'
    'ukui-notification-daemon'
    'ukui-themes'
    'ukui-menus'
    'qt5-ukui-platformtheme'
    'peony'
    'mate-desktop'
    'gvfs'
    # MOWIS DeX layer
    'picom'
    'rofi'
    'dunst'
    'feh'
    'kvantum'
    'qt5ct'
    'papirus-icon-theme'
    'noto-fonts'
    'noto-fonts-emoji'
    'python-psutil'
    'python-gobject'
    'libnotify'
    'xorg-xrandr'
    'xorg-xsetroot'
    'lightdm'
    'ukui-greeter'
)

optdepends=(
    'ukui-system-monitor: system monitor'
    'ukui-power-manager: power management'
    'ukui-screensaver: screen saver and lock'
    'ukui-biometric-auth: fingerprint authentication'
    'ukui-media: media utilities'
    'ukui-window-switch: alt-tab switcher'
    'kylin-nm: network manager applet'
    'blueman: bluetooth manager'
    'pasystray: audio tray'
    'scrot: screenshot tool'
    'python-cairo: MOWIS system widget'
)

source=("$pkgname-$pkgver.tar.gz::https://github.com/mowis-de/mowis-desktop-environment/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # GSchema override
    install -Dm644 debian/mowis.gschema.override \
        "$pkgdir/usr/share/glib-2.0/schemas/50_mowis.gschema.override"

    # README
    install -Dm644 README.md \
        "$pkgdir/usr/share/doc/$pkgname/README.md"
}
